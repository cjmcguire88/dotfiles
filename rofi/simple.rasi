* {
    background-color:  transparent ;
    border-color:  #1793d1;
    text-color: #edfefe;
    separator-color: @border-color;
    font: "Fira Sans 12";
    show-icons: true;
}

window {
    border: 0px;
    padding: 5px;
    height: 850px;
    width: 325px;
    background-image: linear-gradient(to bottom, #161817, #202124, #333333);
}

mainbox {
    padding: 5px;
}

inputbar {
    border: 2px;
    border-radius: 12px;
    children: [prompt,entry];
}

prompt {
    background-color: @border-color;
    padding: 5px 5px 0px;
    text-color: #000000;
}

// Not used
textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 5px;
}

listview {
    border: 0px 0px 0px;
    padding: 10px 0px 0px 0px;
    columns: 1;
}

element {
    padding: 5px 0px 5px 20px;
    border-radius: 30px;
}

element-icon {
    size: 35;
}

element-text {
    padding: 0.2em;
}

element selected {
    background-image: linear-gradient(#1793d1, #89b4fa, #1793d1);
    text-color: #000000;
}
