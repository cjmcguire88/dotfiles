// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "group/hardware",
        "idle_inhibitor",
        "custom/bridge",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],
    "hyprland/window": {
        "icon": true,
        "icon-size": 20
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{icon}",
        "format-icons": {
            "1": "󰎤",
            "2": "󰎧",
            "3": "󰎪",
            "4": "󰎭",
            "5": "󰎱",
            "6": "󰎳",
            "7": "󰎶",
            "8": "󰎹",
            "9": "󰎼",
            "urgent": "󰀧",
            "focused": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 3
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰷛 ",
            "deactivated": "󰷛 "
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "timezone": "America/New_York",
        "format": "{:%I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "on-scroll": 1,
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weekdays": "<span color='#f38ba8'><b>{}</b></span>",
                "today": "<span color='#a6e3a1'><b><u>{}</u></b></span>"
            }
        },
        "on-click": "kill -s USR1 $(pidof deadd-notification-center)"
    },
    "cpu": {
        "format": "{usage}% ",
        "format-alt": "{avg_frequency} GHz 󰾆",
        "tooltip": false,
    },
    "group/volume": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-audio",
            "transition-left-to-right": true,
        },
        "modules": [
            "pulseaudio",
            "pulseaudio-slider",
            "backlight-slider",
        ]
    },
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-cpu",
            "transition-left-to-right": true,
        },
        "modules": [
            "cpu",
            "memory",
            "temperature",
        ]
    },
    "memory": {
        "format": "{percentage}% ",
        "format-alt": "Swap: {swapPercentage}% 󰿡",
        "on-click-right": ""
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-alt": "{temperatureF}°F {icon}",
        "format-icons": [
            "",
            "",
            "󰈸"
        ],
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": [
            "󱩎",
            "󱩏",
            "󱩐",
            "󱩑",
            "󱩒",
            "󱩓",
            "󱩔",
            "󱩕",
            "󱩖"
        ]
    },
    "backlight/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "device": ""
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon}󰉁",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "󰂃",
            "󰁻",
            "󰁾",
            "󰂀",
            "󰁹"
        ]
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} 󰈀",
        "tooltip-format": "{ifname} via {gwaddr} 󰩠",
        "format-linked": "{ifname} (No IP) 󰲊",
        "format-disconnected": "Disconnected 󰌙",
        "format-alt": "󰛶 {bandwidthUpBits} | 󰛴 {bandwidthDownBits}",
        "on-click-right": "iwgtk"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-alt": "{format_source}",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": "󰝟 {icon}",
        "format-muted": "󰝟 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "󱡏 ",
            "hands-free": "󰋎 ",
            "headset": "󱀞 ",
            "portable": " ",
            "car": " ",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click-right": "pwvucontrol"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "user": {
        "format": " (↑{work_H} Hrs)",
        "interval": 60,
        "height": 30,
        "width": 30
    },
    "custom/arch": {
        "format": " 󰣇 ",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "$HOME/.config/rofi/powermenu/type-2/powermenu.sh"
    },
    "custom/pacman": {
        "format": "{icon}",
        "return-type": "json",
        "format-icons": {
            "pending-updates": "",
            "updated": " "
        },
        "on-click": "kitty pacwrap",
        "exec-if": "which waybar-updates",
        "exec": "waybar-updates"
    },
    "custom/bridge": {
        "exec": "$HOME/.config/waybar/scripts/bridge.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 10,
        "on-click": "bash $HOME/.config/waybar/scripts/bridge.sh toggle",
        "format": "{}",
        "tooltip": true
    }
}
